# Copy to .env. Never commit .env.
PHARMALENS_DB=data/pharmalens.duckdb
# Optional: openFDA key raises rate limits
OPENFDA_API_KEY=
# Alerts (optional). Telegram: create a bot with @BotFather, paste its token.
TELEGRAM_BOT_TOKEN=
# Email via SMTP (e.g. Gmail app password: smtp.gmail.com / 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Link base used in alert messages
PHARMALENS_PUBLIC_URL=http://localhost:8010
